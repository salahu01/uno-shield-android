    <uses-permission android:name="com.mediatek.permission.CTA_ENABLE_WIFI"/>
    <uses-permission android:name="com.mediatek.permission.CTA_ENABLE_BT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
